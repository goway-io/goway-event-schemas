{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GowayEventSchemas",
  "x-subjects": {
    "booking.cancelled": "BookingCancelled",
    "driver.stats_changed": "DriverStatsChanged",
    "wallet.eligibility_changed": "WalletEligibilityChanged"
  },
  "x-frames": {
    "client": {
      "go_online": "GoOnlineFrame",
      "offer_response": "OfferResponseFrame"
    },
    "server": {
      "error": "ErrorFrame",
      "offer_proposed": "OfferProposedFrame",
      "offer_result": "OfferResultFrame"
    }
  },
  "definitions": {
    "BookingCancelled": {
      "title": "BookingCancelled",
      "description": "A booking ended before the cargo was loaded. The load goes back to the board.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
        },
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "by": {
          "$ref": "#/definitions/CancelledBy"
        },
        "reason": {
          "type": "string",
          "description": "What the canceller wrote; empty when nothing was written."
        },
        "shipper_org_id": {
          "type": "string",
          "format": "uuid"
        },
        "carrier_org_id": {
          "type": "string",
          "format": "uuid"
        },
        "driver_user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Null when no driver was assigned."
        }
      },
      "required": [
        "event_id",
        "booking_id",
        "load_id",
        "by",
        "reason",
        "shipper_org_id",
        "carrier_org_id",
        "driver_user_id"
      ]
    },
    "CancelledBy": {
      "title": "CancelledBy",
      "type": "string",
      "enum": [
        "shipper",
        "carrier",
        "operator"
      ],
      "description": "Who cancelled."
    },
    "ClientFrame": {
      "title": "ClientFrame",
      "description": "Any frame an app may send; `type` tells which.",
      "discriminator": "type",
      "oneOf": [
        {
          "$ref": "#/definitions/GoOnlineFrame"
        },
        {
          "$ref": "#/definitions/OfferResponseFrame"
        }
      ]
    },
    "DriverStatsChanged": {
      "title": "DriverStatsChanged",
      "description": "A driver's completed-haul count or rating changed. Counters only grow, so a late older event is recognisable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "completed_count": {
          "type": "integer",
          "minimum": 0
        },
        "rating_avg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5,
          "description": "Null until the first rating."
        },
        "rating_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "event_id",
        "user_id",
        "completed_count",
        "rating_avg",
        "rating_count"
      ]
    },
    "ErrorFrame": {
      "title": "ErrorFrame",
      "description": "Frame `error` goway-realtime sends to an app.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "data": {
          "$ref": "#/definitions/FrameError"
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "When the server sent the frame, RFC 3339 UTC."
        }
      },
      "required": [
        "type",
        "data",
        "ts"
      ]
    },
    "FrameError": {
      "title": "FrameError",
      "description": "A frame was refused; the same problem shape as REST errors.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable code the app branches on."
        },
        "key": {
          "type": "string",
          "description": "Translation key for the message."
        },
        "status": {
          "type": "integer"
        },
        "detail": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "description": "Values for the translated message."
        }
      },
      "required": [
        "code"
      ]
    },
    "GoOnline": {
      "title": "GoOnline",
      "description": "Start receiving instant offers on a line with one vehicle.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "to_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "vehicle_id": {
          "type": "string",
          "format": "uuid"
        },
        "duration_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48,
          "default": 12,
          "description": "How long to stay online; must be one of the allowed durations."
        },
        "bidirectional": {
          "type": "boolean",
          "default": true,
          "description": "Also take loads on the way back."
        }
      },
      "required": [
        "from_region_id",
        "to_region_id",
        "vehicle_id"
      ]
    },
    "GoOnlineFrame": {
      "title": "GoOnlineFrame",
      "description": "Frame `go_online` an app sends to goway-realtime.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "go_online"
        },
        "data": {
          "$ref": "#/definitions/GoOnline"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    "IneligibleReason": {
      "title": "IneligibleReason",
      "type": "string",
      "enum": [
        "debt",
        "subscription"
      ]
    },
    "OfferAction": {
      "title": "OfferAction",
      "type": "string",
      "enum": [
        "accept",
        "decline"
      ]
    },
    "OfferOutcome": {
      "title": "OfferOutcome",
      "type": "string",
      "enum": [
        "won",
        "lost",
        "declined",
        "expired",
        "withdrawn"
      ]
    },
    "OfferProposed": {
      "title": "OfferProposed",
      "description": "An instant load offered to this driver; answer before `deadline_at`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "from_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "to_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "truck_class": {
          "type": "string"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Price in minor units of `currency`."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "weight_kg": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_at": {
          "type": "integer",
          "description": "Answer deadline, unix milliseconds in server time."
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "load_id",
        "from_region_id",
        "to_region_id",
        "truck_class",
        "amount",
        "currency",
        "weight_kg",
        "deadline_at",
        "server_time"
      ]
    },
    "OfferProposedFrame": {
      "title": "OfferProposedFrame",
      "description": "Frame `offer_proposed` goway-realtime sends to an app.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "offer_proposed"
        },
        "data": {
          "$ref": "#/definitions/OfferProposed"
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "When the server sent the frame, RFC 3339 UTC."
        }
      },
      "required": [
        "type",
        "data",
        "ts"
      ]
    },
    "OfferResponse": {
      "title": "OfferResponse",
      "description": "The driver's answer to an instant offer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "$ref": "#/definitions/OfferAction"
        }
      },
      "required": [
        "load_id",
        "action"
      ]
    },
    "OfferResponseFrame": {
      "title": "OfferResponseFrame",
      "description": "Frame `offer_response` an app sends to goway-realtime.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "offer_response"
        },
        "data": {
          "$ref": "#/definitions/OfferResponse"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    "OfferResult": {
      "title": "OfferResult",
      "description": "How an offer ended for this driver.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "outcome": {
          "$ref": "#/definitions/OfferOutcome"
        },
        "booking_id": {
          "type": "string",
          "format": "uuid",
          "description": "Set when the outcome is `won`."
        }
      },
      "required": [
        "load_id",
        "outcome"
      ]
    },
    "OfferResultFrame": {
      "title": "OfferResultFrame",
      "description": "Frame `offer_result` goway-realtime sends to an app.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "offer_result"
        },
        "data": {
          "$ref": "#/definitions/OfferResult"
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "When the server sent the frame, RFC 3339 UTC."
        }
      },
      "required": [
        "type",
        "data",
        "ts"
      ]
    },
    "ServerFrame": {
      "title": "ServerFrame",
      "description": "Any frame goway-realtime may send; `type` tells which.",
      "discriminator": "type",
      "oneOf": [
        {
          "$ref": "#/definitions/OfferProposedFrame"
        },
        {
          "$ref": "#/definitions/OfferResultFrame"
        },
        {
          "$ref": "#/definitions/ErrorFrame"
        }
      ]
    },
    "WalletEligibilityChanged": {
      "title": "WalletEligibilityChanged",
      "description": "An organization's wallet started or stopped being allowed to receive offers. One event per user of the organization.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
        },
        "org_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "eligible": {
          "type": "boolean"
        },
        "balance": {
          "type": "integer",
          "description": "Wallet balance in so'm; negative means debt."
        },
        "debt_limit": {
          "type": "integer",
          "minimum": 0,
          "description": "How far below zero the balance may go, so'm."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/definitions/IneligibleReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why offers stopped; null when the wallet is eligible."
        }
      },
      "required": [
        "event_id",
        "org_id",
        "user_id",
        "eligible",
        "balance",
        "debt_limit",
        "reason"
      ]
    }
  }
}
