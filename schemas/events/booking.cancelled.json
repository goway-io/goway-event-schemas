{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookingCancelled",
  "description": "A booking ended before the cargo was loaded. The load goes back to the board.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "booking_id": {
      "type": "string",
      "format": "uuid"
    },
    "load_id": {
      "type": "string",
      "format": "uuid"
    },
    "by": {
      "title": "CancelledBy",
      "type": "string",
      "enum": [
        "shipper",
        "carrier",
        "operator"
      ],
      "description": "Who cancelled."
    },
    "reason": {
      "type": "string",
      "description": "What the canceller wrote; empty when nothing was written."
    },
    "shipper_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "carrier_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "driver_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Null when no driver was assigned."
    }
  },
  "required": [
    "event_id",
    "booking_id",
    "load_id",
    "by",
    "reason",
    "shipper_org_id",
    "carrier_org_id",
    "driver_user_id"
  ]
}
