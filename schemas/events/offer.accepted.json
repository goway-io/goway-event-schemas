{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OfferAccepted",
  "description": "An offer was accepted and became a booking; published together with `booking.created`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "offer_id": {
      "type": "string",
      "format": "uuid"
    },
    "load_id": {
      "type": "string",
      "format": "uuid"
    },
    "booking_id": {
      "type": "string",
      "format": "uuid"
    },
    "shipper_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "carrier_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "driver_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The driver who made the offer; the code allows null, an offer always has one."
    }
  },
  "required": [
    "event_id",
    "offer_id",
    "load_id",
    "booking_id",
    "shipper_org_id",
    "carrier_org_id",
    "driver_user_id"
  ]
}
