{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OfferCreated",
  "description": "A carrier asked for a load, or either side countered the other's price.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "offer_id": {
      "type": "string",
      "format": "uuid"
    },
    "load_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "title": "OfferKind",
      "type": "string",
      "enum": [
        "carrier_request",
        "carrier_counter",
        "shipper_counter"
      ],
      "description": "Who made the offer and how."
    },
    "carrier_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "shipper_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "integer",
      "minimum": 0,
      "description": "Offered price, whole so'm (a bare integer; `currency` is UZS today)."
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "description": "ISO 4217 code; `UZS` today."
    }
  },
  "required": [
    "event_id",
    "offer_id",
    "load_id",
    "kind",
    "carrier_org_id",
    "shipper_org_id",
    "amount",
    "currency"
  ]
}
