{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookingStatusChanged",
  "description": "The carrier moved the haul one step on: `en_route`, `at_pickup`, `loading`, `in_transit` or `delivered`. Completion and cancellation have their own subjects.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "booking_id": {
      "type": "string",
      "format": "uuid"
    },
    "load_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "title": "BookingStatus",
      "type": "string",
      "enum": [
        "confirmed",
        "en_route",
        "at_pickup",
        "loading",
        "in_transit",
        "delivered",
        "completed",
        "cancelled"
      ]
    },
    "shipper_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "carrier_org_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "event_id",
    "booking_id",
    "load_id",
    "status",
    "shipper_org_id",
    "carrier_org_id"
  ]
}
