{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriverStatsChanged",
  "description": "A driver's completed-haul count or rating changed. Counters only grow, so a late older event is recognisable.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "completed_count": {
      "type": "integer",
      "minimum": 0
    },
    "rating_avg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 5,
      "description": "Null until the first rating."
    },
    "rating_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "event_id",
    "user_id",
    "completed_count",
    "rating_avg",
    "rating_count"
  ]
}
