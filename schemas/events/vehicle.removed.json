{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleRemoved",
  "description": "A fleet vehicle was removed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "vehicle_id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "event_id",
    "vehicle_id",
    "org_id"
  ]
}
