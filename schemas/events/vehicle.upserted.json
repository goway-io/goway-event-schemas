{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleUpserted",
  "description": "A fleet vehicle was added or changed; the whole vehicle is sent every time.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "vehicle_id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "plate_number": {
      "type": "string",
      "description": "Normalized plate: no spaces, upper case."
    },
    "truck_class": {
      "type": "string",
      "description": "Truck class code from the reference list."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Capability codes: rear_ramp, open_top, side_curtain, tail_lift, refrigerated."
    },
    "loading_method": {
      "title": "VehicleLoadingMethod",
      "type": "string",
      "enum": [
        "top",
        "rear",
        "both"
      ],
      "description": "How the vehicle is loaded."
    },
    "capacity_kg": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Payload in kilograms; null when not given."
    },
    "brand": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40,
      "description": "Make, as the driver entered it."
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": "Model, as the driver entered it."
    },
    "color": {
      "anyOf": [
        {
          "title": "VehicleColor",
          "type": "string",
          "enum": [
            "white",
            "black",
            "silver",
            "gray",
            "red",
            "blue",
            "green",
            "yellow",
            "orange",
            "brown",
            "beige",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Body colour code; apps name it in their language."
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1970,
      "maximum": 2100,
      "description": "Year of manufacture."
    },
    "volume_m3": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "maximum": 200,
      "description": "Body volume in m³."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the vehicle was saved. ISO 8601 with offset, as Python's `isoformat()` writes it."
    }
  },
  "required": [
    "event_id",
    "vehicle_id",
    "org_id",
    "plate_number",
    "truck_class",
    "capabilities",
    "loading_method",
    "capacity_kg",
    "updated_at"
  ]
}
