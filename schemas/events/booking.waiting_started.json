{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookingWaitingStarted",
  "description": "The free waiting at the pickup ran out and paid waiting began. Once per booking.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "booking_id": {
      "type": "string",
      "format": "uuid"
    },
    "load_id": {
      "type": "string",
      "format": "uuid"
    },
    "shipper_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "shipper_user_id": {
      "type": "string",
      "format": "uuid",
      "description": "The person who posted the load."
    },
    "carrier_org_id": {
      "type": "string",
      "format": "uuid"
    },
    "driver_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "rate_per_minute": {
      "type": "integer",
      "minimum": 0,
      "description": "Whole so'm per minute."
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    }
  },
  "required": [
    "event_id",
    "booking_id",
    "load_id",
    "shipper_org_id",
    "shipper_user_id",
    "carrier_org_id",
    "driver_user_id",
    "started_at",
    "rate_per_minute",
    "currency"
  ]
}
