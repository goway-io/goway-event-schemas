{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupportMessageCreated",
  "description": "A message was added to a support conversation, by the person who opened it or by an operator.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event, stamped by the publisher's outbox. Consumers dedupe on it."
    },
    "ticket_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string",
      "description": "The ticket's short number."
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "author": {
      "title": "SupportAuthor",
      "type": "string",
      "enum": [
        "user",
        "operator"
      ]
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "The person the conversation belongs to."
    },
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "ticket_id",
    "number",
    "message_id",
    "author",
    "user_id",
    "text",
    "created_at"
  ]
}
