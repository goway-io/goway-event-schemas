{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoardLoadRemovedFrame",
  "description": "Frame `board_load_removed` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "board_load_removed"
    },
    "data": {
      "title": "BoardLoadRemoved",
      "description": "A load left a subscribed lane's board. A signal; the app drops it from the list.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "from_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "to_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "title": "BoardRemovalReason",
          "type": "string",
          "enum": [
            "booked",
            "cancelled",
            "expired"
          ]
        }
      },
      "required": [
        "load_id",
        "from_region_id",
        "to_region_id",
        "reason"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
