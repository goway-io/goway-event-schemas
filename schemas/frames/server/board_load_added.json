{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoardLoadAddedFrame",
  "description": "Frame `board_load_added` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "board_load_added"
    },
    "data": {
      "title": "BoardLoadAdded",
      "description": "A load appeared on a subscribed lane: newly posted or back after a cancelled booking. A signal; the app reads the list again over REST.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "from_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "to_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "plan": {
          "type": "boolean"
        }
      },
      "required": [
        "load_id",
        "from_region_id",
        "to_region_id",
        "plan"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
