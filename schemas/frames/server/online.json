{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OnlineFrame",
  "description": "Frame `online` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "online"
    },
    "data": {
      "title": "Online",
      "description": "The driver is on their line: after `go_online`, and again whenever the line is changed while online.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_region_id": {
          "type": "string",
          "format": "uuid",
          "description": "Where the line starts."
        },
        "to_region_id": {
          "type": "string",
          "format": "uuid",
          "description": "Where the line ends."
        },
        "bidirectional": {
          "type": "boolean",
          "description": "The way back is taken too."
        },
        "vehicle_id": {
          "type": "string",
          "format": "uuid",
          "description": "The truck the offers are matched against."
        },
        "queue_position": {
          "type": "integer",
          "minimum": 1,
          "description": "Place in the outbound line's queue, from 1."
        },
        "offers_blocked": {
          "anyOf": [
            {
              "title": "OffersBlockedReason",
              "type": "string",
              "enum": [
                "BALANCE_INSUFFICIENT",
                "SUBSCRIPTION_REQUIRED"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when the wallet blocks offers, with the reason; null otherwise."
        }
      },
      "required": [
        "from_region_id",
        "to_region_id",
        "bidirectional",
        "vehicle_id",
        "queue_position",
        "offers_blocked"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
