{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchExhaustedFrame",
  "description": "Frame `search_exhausted` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "search_exhausted"
    },
    "data": {
      "title": "SearchExhausted",
      "description": "To the shipper: no driver took the load within the search window. The search goes on; the app offers to raise the price, move the pickup to a plan or cancel.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "seen": {
          "type": "integer",
          "minimum": 0
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Current price, whole so'm."
        },
        "suggested_amount": {
          "type": "integer",
          "minimum": 0,
          "description": "The raised price GoWay suggests."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": [
        "load_id",
        "seen",
        "amount",
        "suggested_amount",
        "currency"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
