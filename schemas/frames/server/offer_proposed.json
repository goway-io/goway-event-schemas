{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OfferProposedFrame",
  "description": "Frame `offer_proposed` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "offer_proposed"
    },
    "data": {
      "title": "OfferProposed",
      "description": "An instant load offered to this driver; answer before `deadline_at`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "from_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "to_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "truck_class": {
          "type": "string"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Price in minor units of `currency`."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "weight_kg": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_at": {
          "type": "integer",
          "description": "Answer deadline, unix milliseconds in server time."
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        },
        "pickup_address": {
          "type": [
            "string",
            "null"
          ],
          "description": "First pickup stop's address as the shipper wrote it; null only when the load has no stops."
        },
        "dropoff_address": {
          "type": [
            "string",
            "null"
          ],
          "description": "Last drop-off stop's address; null only when the load has no stops."
        },
        "stops_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Pickup and drop-off stops together."
        },
        "distance_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Driving distance through the stops; null when routing was unavailable at posting."
        },
        "duration_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Driving time for the same route in minutes; null together with the distance."
        },
        "pickup_distance_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Straight-line distance from the driver's last position to the pickup; null while the position is unknown."
        },
        "pickup_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Earliest pickup; null when not given. ISO 8601 with offset, as Python's `isoformat()` writes it."
        },
        "pickup_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Latest pickup, also the posting's expiry; null when not given. ISO 8601 with offset, as Python's `isoformat()` writes it."
        },
        "cargo_category": {
          "type": "string",
          "description": "Cargo type code from the reference catalogue."
        },
        "volume_m3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "loaders_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Loaders the shipper ordered with the truck."
        },
        "loading_method": {
          "title": "LoadingMethod",
          "type": "string",
          "enum": [
            "top",
            "rear"
          ],
          "description": "How the cargo goes in."
        },
        "needs_refrigeration": {
          "type": "boolean"
        },
        "payment_method": {
          "title": "PaymentMethod",
          "type": "string",
          "enum": [
            "cash",
            "transfer",
            "card",
            "mixed"
          ]
        },
        "is_urgent": {
          "type": "boolean"
        }
      },
      "required": [
        "load_id",
        "from_region_id",
        "to_region_id",
        "truck_class",
        "amount",
        "currency",
        "weight_kg",
        "deadline_at",
        "server_time",
        "pickup_address",
        "dropoff_address",
        "stops_count",
        "distance_km",
        "duration_min",
        "pickup_distance_km",
        "pickup_from",
        "pickup_to",
        "cargo_category",
        "volume_m3",
        "loaders_count",
        "loading_method",
        "needs_refrigeration",
        "payment_method",
        "is_urgent"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
