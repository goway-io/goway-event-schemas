{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookingUpdatedFrame",
  "description": "Frame `booking_updated` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "booking_updated"
    },
    "data": {
      "title": "BookingUpdated",
      "description": "Something on a haul changed besides its step; sent to the driver and the shipper without a subscription. A signal: the app reads the booking again.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "change": {
          "title": "BookingChange",
          "type": "string",
          "enum": [
            "issue_opened",
            "issue_resolved",
            "waiting_started"
          ]
        },
        "issue_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "booking_id",
        "change",
        "issue_id"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
