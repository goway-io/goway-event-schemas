{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookingEtaFrame",
  "description": "Frame `booking_eta` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "booking_eta"
    },
    "data": {
      "title": "BookingEtaData",
      "description": "The arrival window or the road position changed. The internal event's ids for organizations, recipients and the event itself never reach an app.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "title": "BookingStatus",
          "type": "string",
          "enum": [
            "confirmed",
            "en_route",
            "at_pickup",
            "loading",
            "in_transit",
            "delivered",
            "completed",
            "cancelled"
          ]
        },
        "eta_stop": {
          "anyOf": [
            {
              "title": "EtaStop",
              "type": "string",
              "enum": [
                "pickup",
                "dropoff"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Which stop the window is for; null when no arrival is expected any more."
        },
        "eta_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Earliest expected arrival at `eta_stop`; null with it. ISO 8601 with offset, as Python's `isoformat()` writes it."
        },
        "eta_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Latest expected arrival at `eta_stop`; null with it. ISO 8601 with offset, as Python's `isoformat()` writes it."
        },
        "remaining_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Road kilometres left to the next stop; null before the haul sets off or while routing is unavailable."
        },
        "last_waypoint": {
          "anyOf": [
            {
              "title": "PassedWaypoint",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "region_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "passed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "region_id",
                "passed_at"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The last region boundary the truck crossed, for «Angrendan o'tdi · 142 km qoldi»; null until it crosses one."
        }
      },
      "required": [
        "booking_id",
        "load_id",
        "status",
        "eta_stop",
        "eta_from",
        "eta_to",
        "remaining_km",
        "last_waypoint"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
