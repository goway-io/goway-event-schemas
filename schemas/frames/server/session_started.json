{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionStartedFrame",
  "description": "Frame `session_started` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "session_started"
    },
    "data": {
      "title": "SessionStarted",
      "description": "Somebody signed in to this account; ignore it when `installation_id` is this app's own. Copied from `user.login`; a field that event lacked or sent empty arrives as null.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "installation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "anyOf": [
            {
              "title": "DevicePlatform",
              "type": "string",
              "enum": [
                "android",
                "ios",
                "web"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Device platform."
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Device model."
        },
        "new_device": {
          "type": "boolean"
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When the sign-in happened, as `user.login` wrote it."
        }
      },
      "required": [
        "device_id",
        "installation_id",
        "platform",
        "model",
        "new_device",
        "at"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
