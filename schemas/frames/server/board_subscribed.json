{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoardSubscribedFrame",
  "description": "Frame `board_subscribed` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "board_subscribed"
    },
    "data": {
      "title": "BoardSubscribed",
      "description": "`subscribe_board` was accepted.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_region_id": {
          "type": "string",
          "format": "uuid"
        },
        "to_region_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "from_region_id",
        "to_region_id"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
