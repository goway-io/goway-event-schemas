{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatReadFrame",
  "description": "Frame `chat_read` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "chat_read"
    },
    "data": {
      "title": "ChatReadData",
      "description": "One side read a haul's chat up to a message. The internal event's ids for organizations, recipients and the event itself never reach an app.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "reader_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "reader_side": {
          "title": "ChatSide",
          "type": "string",
          "enum": [
            "carrier",
            "shipper"
          ],
          "description": "The side of the haul the person writes for."
        },
        "last_read_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "read_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "booking_id",
        "reader_user_id",
        "reader_side",
        "last_read_message_id",
        "read_at"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
