{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OffersBlockedFrame",
  "description": "Frame `offers_blocked` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "offers_blocked"
    },
    "data": {
      "title": "OffersBlocked",
      "description": "The wallet stopped being eligible; no offers until it is settled.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "OffersBlockedReason",
          "type": "string",
          "enum": [
            "BALANCE_INSUFFICIENT",
            "SUBSCRIPTION_REQUIRED"
          ]
        }
      },
      "required": [
        "reason"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
