{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotificationFrame",
  "description": "Frame `notification` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "notification"
    },
    "data": {
      "title": "Notification",
      "description": "Something landed in the user's notification feed. `data` opens the right screen on tap and `unread` is the new badge. Copied from `notification.created`; a field that event lacked or sent empty arrives as null.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notification_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "Template kind, for example `driver_found` or `announcement`."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Title in the user's language."
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text in the user's language."
        },
        "data": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "The keys that open the screen, as the push carries them (`booking_id`, `load_id`, `ticket_id`...)."
        },
        "unread": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Unread feed items, this one included."
        }
      },
      "required": [
        "notification_id",
        "kind",
        "title",
        "body",
        "data",
        "unread"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
