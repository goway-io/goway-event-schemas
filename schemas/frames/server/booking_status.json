{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookingStatusFrame",
  "description": "Frame `booking_status` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "booking_status"
    },
    "data": {
      "title": "BookingStatusData",
      "description": "The haul moved to another step. The internal event's ids for organizations, recipients and the event itself never reach an app.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "title": "BookingStatus",
          "type": "string",
          "enum": [
            "confirmed",
            "en_route",
            "at_pickup",
            "loading",
            "in_transit",
            "delivered",
            "completed",
            "cancelled"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the step happened: the driver's tap, which an app offline for a while sends late. Steps arrive in order; this is the time to show."
        }
      },
      "required": [
        "booking_id",
        "load_id",
        "status",
        "occurred_at"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
