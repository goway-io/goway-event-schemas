{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatTypingFrame",
  "description": "Frame `chat_typing` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "chat_typing"
    },
    "data": {
      "title": "ChatTyping",
      "description": "The other side is typing in a haul's chat. Not stored; show it for a few seconds.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "booking_id",
        "user_id"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
