{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatMessageFrame",
  "description": "Frame `chat_message` goway-realtime sends to an app.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "chat_message"
    },
    "data": {
      "title": "ChatMessageData",
      "description": "A message in a haul's chat, to both sides and to the writer's other devices. The internal event's ids for organizations, recipients and the event itself never reach an app.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_message_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "The sending app's id for the message, so a resend after a lost reply shows once."
        },
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "load_id": {
          "type": "string",
          "format": "uuid"
        },
        "sender_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "sender_side": {
          "title": "ChatSide",
          "type": "string",
          "enum": [
            "carrier",
            "shipper"
          ],
          "description": "The side of the haul the person writes for."
        },
        "kind": {
          "title": "ChatMessageKind",
          "type": "string",
          "enum": [
            "text",
            "quick_reply",
            "photo",
            "location"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "description": "The words; for a quick reply, its text in the sender's language. Null for a bare photo or location."
        },
        "quick_reply_code": {
          "type": [
            "string",
            "null"
          ],
          "description": "Code from the quick replies catalogue when `kind` is `quick_reply`."
        },
        "photo_file_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "The `chat_photo` file; the app reads its link over REST."
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "message_id",
        "client_message_id",
        "booking_id",
        "load_id",
        "sender_user_id",
        "sender_side",
        "kind",
        "text",
        "quick_reply_code",
        "photo_file_id",
        "lat",
        "lng",
        "created_at"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the server sent the frame, RFC 3339 UTC."
    }
  },
  "required": [
    "type",
    "data",
    "ts"
  ]
}
