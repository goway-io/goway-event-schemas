{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnsubscribeBookingFrame",
  "description": "Frame `unsubscribe_booking` an app sends to goway-realtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "unsubscribe_booking"
    },
    "data": {
      "title": "UnsubscribeBooking",
      "description": "Stop watching a booking.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "booking_id"
      ]
    }
  },
  "required": [
    "type",
    "data"
  ]
}
