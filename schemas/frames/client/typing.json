{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TypingFrame",
  "description": "Frame `typing` an app sends to goway-realtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "typing"
    },
    "data": {
      "title": "Typing",
      "description": "The caller is typing in a haul's chat; sent at most every few seconds while typing.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "booking_id"
      ]
    }
  },
  "required": [
    "type",
    "data"
  ]
}
